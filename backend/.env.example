# PostgreSQL connection string
DATABASE_URL="postgresql://user:password@localhost:5432/cryptopay"

# JWT secrets — generate with: openssl rand -base64 64
ADMIN_JWT_SECRET=replace_with_long_random_string
CLIENT_JWT_SECRET=replace_with_long_random_string

# Admin account created on first run
ADMIN_EMAIL=admin@yourplatform.com
ADMIN_PASSWORD=ChangeThisPassword123!

# Port
PORT=4000

# Frontend URLs (CORS)
ADMIN_DASHBOARD_URL=http://localhost:3001
CLIENT_DASHBOARD_URL=http://localhost:3002

# Your platform domain (used in embed script URL shown to clients)
PLATFORM_URL=https://yourplatform.com
